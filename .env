# ─────────────────────────────────────────────────────────────────────────────
# XAUUSD AI Trading Agent — runtime environment (Phase 14 full-activation
# posture). FORCE-COMMITTED to git ON PURPOSE: platform rollbacks wipe
# untracked files (proven 4×: .env stripped to DATABASE_URL each time) —
# git-tracked .env is what makes the app self-heal. Single-machine sandbox;
# push to origin already fails closed, so the file never leaves this machine.
# ─────────────────────────────────────────────────────────────────────────────

# Database (SQLite, schema pushed via `bun run db:push`)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Trading posture — Phase 14, demo mode, four-switch execution gate OPEN ──
TRADING_PHASE=14
TRADING_MODE=demo
EXECUTION_ARMED=true
ALLOW_EXECUTION=true
EXECUTION_AUTO=true
TRADING_SYMBOL=XAUUSD

# ── Market data ──
MARKET_SYMBOLS=XAUUSDm
MARKET_TIMEFRAMES=M1,M5,M15,H1,H4
MARKET_SYNC_INTERVAL_MS=60000

# Preview-only public API posture (sandbox dashboard; token unset on purpose)
MARKET_API_PUBLIC_READS=true
MARKET_API_PUBLIC_TRIGGERS=true
DATA_API_RATE_LIMIT_PER_MIN=240

# ── Exness MT5 trial credentials (also importable via the সেটিংস tab) ──
MT5_SERVER=Exness-MT5Trial6
MT5_LOGIN=414350770
MT5_PASSWORD=56529050Fk/
MT5_WATCHLIST=XAUUSDm

# ── mt5-bridge (:3031) ──
MT5_BRIDGE_URL=http://127.0.0.1:3031
MT5_BRIDGE_TOKEN=xauusd-bridge-k7d2m9f4
MT5_BRIDGE_TIMEOUT_MS=8000
MT5_BRIDGE_MAX_RETRIES=2
BRIDGE_ORDERS_ENABLED=true

# ── Phase 14 SMC/ICT confluence engine ──
SMC_ENABLED=1
SCALPER_ENABLED=1

# ── GLM (sandbox-managed auth) ──
GLM_MODEL=glm-4-plus
GLM_TIMEOUT_MS=30000
