# ============================================================================
# XAUUSD AI Trading Agent — Environment Template
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# This file contains PLACEHOLDERS ONLY — no real keys, passwords or tokens.
# ============================================================================

# --- Database (SQLite) ------------------------------------------------------
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Trading safety (Phase 1 = READ-ONLY by design) -------------------------
# Execution requires ALL THREE gates below simultaneously. In Phase 1 the
# effective mode is ALWAYS read_only — demo/live values are ignored until
# the Phase 11 acceptance gate flips TRADING_PHASE to 11 and arms execution.
TRADING_PHASE=1
TRADING_MODE=read_only        # read_only | demo | live (ignored until Phase 11)
EXECUTION_ARMED=false         # master arm switch — false until Phase 11 gate
ALLOW_EXECUTION=false         # redundant second switch; both must be true

# --- GLM orchestration ------------------------------------------------------
# Model access is sandbox-managed via z-ai-web-dev-sdk (server-side only).
# No API key is required from the user; auth is handled by the sandbox.
GLM_MODEL="glm-4-plus"
GLM_TIMEOUT_MS=30000
GLM_MAX_RETRIES=2
GLM_MIN_VERIFY_INTERVAL_MS=10000

# --- MT5 bridge (Phase 2+) --------------------------------------------------
# The bridge runs OUTSIDE this sandbox on its own Linux/Windows VPS because
# MT5 cannot run here (no Wine; MetaTrader5 package is Windows-only).
# Leave empty in Phase 1. Phase 2 defines the bridge contract.
MT5_BRIDGE_URL=""
MT5_BRIDGE_TOKEN=""          # bridge auth token — secret, never commit
MT5_BRIDGE_TIMEOUT_MS=8000

# --- Symbols & limits -------------------------------------------------------
# Adjusted automatically in Phase 2 after live detection of the real Exness
# demo symbol (e.g. XAUUSD, XAUUSDm, GOLD...). No hardcoded assumption.
TRADING_SYMBOL="XAUUSD"
MAX_EVENTS_RETURNED=100
