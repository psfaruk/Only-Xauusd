# ============================================================================
# Only-Xauusd — environment template (PLACEHOLDERS ONLY — NEVER real values)
# ----------------------------------------------------------------------------
# SECURITY (Phase 0 deep-remediation):
#   · Real credentials (broker login/password, bridge token) live ONLY in the
#     local .env file, which is GIT-IGNORED. They are never committed.
#   · If .env is missing, copy this template, fill REAL values, then make a
#     local backup for the fail-closed self-heal guard:
#         cp .env.example .env   # then edit
#         cp .env .zscripts/env.local
#   · Credentials previously found in git history must be treated as
#     compromised and rotated with the broker (see docs/security-rotation.md).
# ============================================================================

# --- database ---------------------------------------------------------------
DATABASE_URL="file:../db/custom.db"

# --- product posture (SIGNAL-ONLY, read-only — enforced in code) -----------
# The app is a market observation + signal + backtest + paper-forward product.
# Order execution code was REMOVED in Phase 0; these keys are informational
# labels only. TRADING_MODE is hard-locked to read_only in src/lib/config.ts.
TRADING_PHASE=15
TRADING_MODE=read_only

# --- market data ------------------------------------------------------------
TRADING_SYMBOL=XAUUSD
MARKET_SYMBOLS=XAUUSDm
MARKET_TIMEFRAMES=M1,M5,M15,H1,H4
MARKET_SYNC_INTERVAL_MS=60000
# Preview/local posture: public READS for the dashboard UI (single-user local
# terminal). Triggers additionally require a same-origin browser request.
MARKET_API_PUBLIC_READS=true
MARKET_API_PUBLIC_TRIGGERS=true
DATA_API_RATE_LIMIT_PER_MIN=120
# API bearer token (recommended in production): set a LONG RANDOM value and
# unset both public flags above. Empty/unset = fail-closed public posture.
# DATA_API_TOKEN=

# --- MT5 bridge (market-data gateway) ---------------------------------------
# REAL values required at runtime; NEVER commit them.
MT5_SERVER=YOUR_BROKER_SERVER_NAME
MT5_LOGIN=YOUR_BROKER_LOGIN_NUMBER
MT5_PASSWORD=YOUR_BROKER_PASSWORD
MT5_BRIDGE_URL=http://localhost:3031
MT5_BRIDGE_TOKEN=YOUR_LOCAL_BRIDGE_TOKEN
MT5_BRIDGE_TIMEOUT_MS=8000
MT5_BRIDGE_MAX_RETRIES=2
MT5_WATCHLIST=XAUUSDm

# --- signal engines (deterministic; thresholds clamped in code) -------------
SMC_ENABLED=1
SCALPER_ENABLED=1
SCALPER_MOMENTUM_ENABLED=true
SCALPER_SL_ATR_MULT=1.5
SCALPER_REWARD_RISK=1.2
SMC_SL_ATR_BUFFER=0.5

# --- AI layer ----------------------------------------------------------------
GLM_MODEL=glm-4-plus
GLM_TIMEOUT_MS=30000
