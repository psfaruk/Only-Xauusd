# ============================================================================
# XAUUSD AI Trading Agent — Environment Template
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# This file contains PLACEHOLDERS ONLY — no real keys, passwords or tokens.
# ============================================================================

# --- Database (SQLite) ------------------------------------------------------
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Trading safety (Phase 1-3 = READ-ONLY by design) ------------------------
# Execution requires ALL THREE gates below simultaneously. Until Phase 11 the
# effective mode is ALWAYS read_only — demo/live values are ignored.
TRADING_PHASE=4
TRADING_MODE=read_only        # read_only | demo | live (ignored until Phase 11)
EXECUTION_ARMED=false         # master arm switch — false until Phase 11 gate
ALLOW_EXECUTION=false         # redundant second switch; both must be true

# --- GLM orchestration ------------------------------------------------------
# Model access is sandbox-managed via z-ai-web-dev-sdk (server-side only).
# No API key is required from the user; auth is handled by the sandbox.
GLM_MODEL="glm-4-plus"
GLM_TIMEOUT_MS=30000
GLM_MAX_RETRIES=2
GLM_MIN_VERIFY_INTERVAL_MS=10000

# --- MT5 bridge (Phase 2 deliverable; Phase 3 consumes it read-only) ---------
# The bridge is a SEPARATE service speaking the v20 mt5-service REST contract:
#   GET /health, /api/status, /api/symbols, /api/quote?symbol=, /api/candles?symbol=&tf=&limit=
# (read-only endpoints only — no order endpoints are called or implemented).
# Phase 2 is not deployed yet: leave MT5_BRIDGE_URL empty and every market-data
# surface fails closed with "ডেটা পাওয়া যাচ্ছে না" (nothing is fabricated).
# When the bridge runs on THIS machine (e.g. mini-services/mt5-service on :3031):
#   MT5_BRIDGE_URL="http://127.0.0.1:3031"
# When it runs on your own VPS, point at that host instead.
MT5_BRIDGE_URL=""
MT5_BRIDGE_TOKEN=""           # sent as x-trader-key — secret, never commit
MT5_BRIDGE_TIMEOUT_MS=8000
MT5_BRIDGE_MAX_RETRIES=2      # bounded retries (0-5); never retries indefinitely

# --- Market data pipeline (Phase 3) ------------------------------------------
# Strict allowlists — anything else is rejected (SYMBOL_NOT_ALLOWED / TIMEFRAME_NOT_ALLOWED).
MARKET_SYMBOLS="XAUUSDm"            # Exness demo symbol for gold (verified name)
# M1 (Task 29): the bridge always served M1 — the app never asked. Chart/analysis
# granularity only; the strategy stays M15-based (signal gates use the rules TFs).
MARKET_TIMEFRAMES="M1,M5,M15,H1,H4"
# Per-timeframe staleness thresholds in SECONDS (defaults = 3 × bar duration;
# M1 default 420s is scheduler-cadence bound, not 3×duration — a 180s threshold
# would flap STALE between 5-minute syncs).
MARKET_STALE_TICK_SEC=120
MARKET_STALE_M1_SEC=420
MARKET_STALE_M5_SEC=900
MARKET_STALE_M15_SEC=2700
MARKET_STALE_H1_SEC=10800
MARKET_STALE_H4_SEC=43200
# Bounded fetch limits.
MARKET_MAX_CANDLES_PER_REQUEST=500     # hard cap 1000
MARKET_BACKFILL_MAX_BARS=5000          # hard cap 20000
MARKET_BACKFILL_MAX_DAYS=30            # hard cap 365
MARKET_MAX_ISSUES_PER_RUN=50           # DataQualityIssue flood control
# Demo-source policy: the bridge's clearly-labelled demo feed is SKIPPED by
# default (recorded as SOURCE_DEMO, nothing ingested). Set true ONLY for
# pipeline testing — demo data is never marked analysis-ready either way.
MARKET_INGEST_DEMO=false
# Scheduled sync interval in ms. 0 = OFF (default). Requires MT5_BRIDGE_URL.
# Example: 300000 = every 5 minutes.
MARKET_SYNC_INTERVAL_MS=0

# --- Data API security (Phase 3, hardened in Phase 4, preview opt-in in Phase 13) --
# FAIL-CLOSED POSTURE (see README §Security):
#   · TRIGGER endpoints (POST /api/data/sync, /api/analysis/run, /api/signal/run)
#     require DATA_API_TOKEN ALWAYS. If it is unset they respond 503
#     MARKET_API_TOKEN_NOT_CONFIGURED and never run — the ONE exception is the
#     explicit preview opt-in MARKET_API_PUBLIC_TRIGGERS=true (Phase 13) which
#     only applies when the token is UNSET. The guarded operations are
#     broker-read-only (sync/analysis/research-signal; no order code exists)
#     and the tight trigger rate-limit bucket still applies.
#   · READ endpoints (GET) require the token whenever it is set. If unset they
#     also fail closed UNLESS MARKET_API_PUBLIC_READS=true is set explicitly
#     (preview/dashboard use only — NEVER in production).
# Production/VPS: set a long random DATA_API_TOKEN and leave public reads AND
# public triggers off.
DATA_API_TOKEN=""
DATA_API_RATE_LIMIT_PER_MIN=120
# Explicit opt-in for unauthenticated GET reads while DATA_API_TOKEN is unset.
# Default false (fail closed). Preview sandbox only — never production.
MARKET_API_PUBLIC_READS=false
# Explicit opt-in for unauthenticated POST triggers while DATA_API_TOKEN is
# unset (Phase 13). Default false (fail closed). Ignored when a token is set.
# Preview sandbox only — never production.
MARKET_API_PUBLIC_TRIGGERS=false

# --- Analysis engine (Phase 4 — deterministic, LLM-free) -----------------------
# All Phase 4 market calculations are pure TypeScript functions — the LLM is
# never asked to compute or override an indicator value.
ANALYSIS_MAX_BARS_PER_TF=300   # closed candles loaded per timeframe (60-1000)
ANALYSIS_MIN_BARS_PER_TF=220   # warm-up floor: covers EMA200 seed + ADX + swings
ANALYSIS_SWING_LEFT=3          # bars required LEFT of a swing candidate (2-8)
ANALYSIS_SWING_RIGHT=3         # bars required RIGHT of a swing candidate (2-8)

# --- Symbols & limits ---------------------------------------------------------
TRADING_SYMBOL="XAUUSDm"
MAX_EVENTS_RETURNED=100

# --- Phase 8: read-only MT5 bridge (mini-services/mt5-bridge, :3031) ---------
# The bridge dials the Exness-MT5Trial6 gateways DIRECTLY by IP over the MT5
# web-terminal protocol (TLS verified, SNI mt5.exwebterm.com) and exposes the
# read-only Phase 3 contract. Credentials live ONLY here — never in code,
# logs, API responses or git. Set MT5_BRIDGE_RELAY=1 only if your bridge
# forwards another host's authenticated feed (it then reports source=relay).
# MT5_LOGIN / MT5_PASSWORD / MT5_SERVER are read by the BRIDGE process only
# (bun run bridge:dev loads this .env via --env-file).
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER="Exness-MT5Trial6"
MT5_WATCHLIST="XAUUSDm"
MT5_BRIDGE_RELAY=""

# --- Phase 8: data & signal health -------------------------------------------
# Scheduled sync keeps the stored tick/candles fresh for the analysis gates.
# 0 = OFF. Example: 300000 = every 5 minutes (requires MT5_BRIDGE_URL).
MARKET_SYNC_INTERVAL_MS=300000

# --- Phase 9: deterministic signal engine -------------------------------------
# Research/decision-support ONLY — never an execution instruction. Thresholds
# are documented in src/lib/signal/rules.ts and persisted with every run.
SIGNAL_MAX_BARS_SINCE_BREAK=8
SIGNAL_ZONE_WIDTH_ATR=0.5
SIGNAL_ENTRY_TOLERANCE_ATR=0.25
SIGNAL_SL_ATR_BUFFER=0.5
SIGNAL_REWARD_RISK=2.0
SIGNAL_MIN_ADX=15
SIGNAL_RSI_BUY_MIN=40
SIGNAL_RSI_BUY_MAX=75
SIGNAL_MAX_SPREAD=0.6
SIGNAL_EXPIRY_BARS=12
SIGNAL_MIN_H4_BARS=200
SIGNAL_MIN_H1_BARS=220

# --- Phase 10.2: autonomous forward-paper loop ---------------------------------
# When the scheduled sync succeeds, the deterministic signal engine is also
# evaluated (READ-ONLY research signal; fail-closed gates inside) so live
# setups are discovered and paper-tracked for the pre-registered forward
# paper protocol (audit/phase10.2-forward-paper-protocol.md). Default ON;
# set 0 to disable. Durability: run `bun run paper:snapshot` + commit after
# each resolution batch (sandbox rebuilds wipe the DB).
FORWARD_PAPER_TRACKING=""

# --- Phase 9: Bengali chat agent ----------------------------------------------
# Allowlisted read-only tools only. Stricter per-IP rate limit than reads.
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_TOOL_ROUNDS=3
CHAT_RATE_LIMIT_PER_MIN=12

# --- Phase 7: deterministic risk gate (src/lib/risk/engine.ts) -----------------
# SAFETY limits (clamped in config.ts — a bad value can never disable a limit).
# The deterministic engine owns these numbers; the LLM never sees or changes
# them. Defaults shown; the risk gate is analysis/audit-only — no order code.
RISK_PERCENT_PER_TRADE=1.0       # % of equity risked per trade (clamp 0.1-5)
RISK_MAX_LOTS=0.10               # hard cap on lot size (clamp 0.01-10)
RISK_MIN_LOTS=0.01               # lot floor — smaller computed lots FAIL (clamp 0.001-10)
RISK_MAX_OPEN_POSITIONS=2        # max simultaneous open positions (clamp 1-10)
RISK_MAX_PENDING_APPROVALS=3     # max pending approvals awaiting the user (clamp 1-10)
RISK_MAX_ORDERS_PER_DAY=6        # max approved orders per UTC day (clamp 1-50)
RISK_MAX_SPREAD_PRICE=0.6        # max accepted spread in PRICE units (clamp 0.1-5);
                                 # separate from SIGNAL_MAX_SPREAD so the risk gate
                                 # stays independent of strategy tuning
RISK_MIN_EQUITY=0                # minimum account equity (clamp 0-100000; 0 = no floor)
RISK_LOT_STEP=0.01               # lot granularity for flooring computed size (clamp 0.001-1)
